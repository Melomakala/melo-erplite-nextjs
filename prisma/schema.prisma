generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  user_id    String    @id @default(cuid())
  username   String    @unique
  password   String
  name       String?
  role       String    @default("USER")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  sessions   Session[]

  @@map("tbl_user_account")
}

model Session {
  session_id    String   @id @default(cuid())
  session_token String   @unique
  user_id       String
  expires_at    DateTime
  created_at    DateTime @default(now())
  user          User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("tbl_user_session")
}

model Category {
  category_id    String   @id @default(cuid())
  name          String
  description   String
  create_by     String
  update_by     String?  @default("")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  products      Product[]

  @@map("tbl_product_category")
}

model Product {
  product_id    String   @id @default(cuid())
  name          String
  category_id   String
  category      Category @relation(fields: [category_id], references: [category_id])
  price         Int @default(0)
  stock         Int @default(0)
  status        String
  create_by     String
  update_by     String?  @default("")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  order_details OrderDetail[]
  

  @@map("tbl_product")
}

model Customer {
  customer_id    String   @id @default(cuid())
  name          String
  phone         String
  email         String?
  address       String?
  status        String

  create_by     String
  update_by     String?  @default("")

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  orders        Order[]

  
  @@map("tbl_customer")
}

model Order {
  order_id      String   @id @default(cuid())
  customer_id   String
  customer      Customer @relation(fields: [customer_id], references: [customer_id])

  order_details OrderDetail[]
  status        String //PENDING PAID SHIPPED COMPLETED CANCELLED
  grand_total   Int @default(0)

  create_by     String
  update_by     String?  @default("")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  @@map("tbl_order")
}

model OrderDetail {
  order_detail_id    String   @id @default(cuid())
  order_id      String
  order         Order @relation(fields: [order_id], references: [order_id])

  product_id    String
  product       Product @relation(fields: [product_id], references: [product_id])
  quantity      Int @default(0)
  price         Int @default(0) // price at the time of order
  total         Int @default(0)  //quantity * price
  create_by     String
  update_by     String?  @default("")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  @@map("tbl_order_detail")
}