generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  user_id    String    @id @default(cuid())
  username   String    @unique
  password   String
  name       String?
  role       String    @default("USER")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  sessions   Session[]

  @@map("tbl_user_account")
}

model Session {
  session_id    String   @id @default(cuid())
  session_token String   @unique
  user_id       String
  expires_at    DateTime
  created_at    DateTime @default(now())
  user          User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("tbl_user_session")
}

model Category {
  category_id    String   @id @default(cuid())
  name          String
  description   String
  create_by     String
  update_by     String?  @default("")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  products      Product[]

  @@map("tbl_product_category")
}

model Product {
  product_id    String   @id @default(cuid())
  name          String
  category_id   String
  category      Category @relation(fields: [category_id], references: [category_id])
  price         Int @default(0)
  stock         Int @default(0)
  status        String
  create_by     String
  update_by     String?  @default("")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("tbl_product")
}

model Customer {
  customer_id    String   @id @default(cuid())
  name          String
  phone         String
  email         String?
  address       String?
  status        String

  create_by     String
  update_by     String?  @default("")

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("tbl_customer")
}
